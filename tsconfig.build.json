    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist/lib",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["tests", "examples", "dist"]
}
